# --- Database (MariaDB via Docker Compose) ---
# Host port 3307 avoids clashing with a locally installed MySQL on 3306. Inside the container it is still 3306.
DATABASE_URL="mysql://study:study@localhost:3307/study"

# --- App ---
NODE_ENV=development
# Long random string used to sign the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Sessions ---
SESSION_EXPIRY_HOURS=720            # sliding; each activity extends by this much (default 720 = 30 days)
SESSION_TOUCH_INTERVAL_MINUTES=5    # min gap between lastActivity writes

# --- Brute-force protection (counts come from AuthLog) ---
AUTH_FAILURE_WINDOW_MINUTES=15      # window for counting failures
AUTH_USERNAME_MAX_FAILURES=5        # per-username failures before temporary lockout
AUTH_USERNAME_LOCKOUT_MINUTES=15
AUTH_IP_MAX_FAILURES=20             # per-IP failures before IpBlock; must be > username max (shared school IPs)
AUTH_LOG_RETENTION_DAYS=30          # cleanup threshold for AuthLog rows
AUTH_REGISTER_MAX_PER_IP=5          # registrations allowed per IP within the window below
AUTH_REGISTER_WINDOW_MINUTES=60     # window for counting registrations (never applied to the "unknown" IP)
# Escalating block durations live in app/server/security.server.ts (code, not env).

# --- Reverse proxy ---
# 0 = do not trust X-Forwarded-For (client IP becomes "unknown"; per-IP blocking inactive).
# N = trust the N right-most hops of X-Forwarded-For. Set to 1 behind a single nginx/Caddy.
TRUSTED_PROXY_COUNT=0

# --- Learning ---
DEFAULT_LESSON_PASSING_SCORE=60     # percent, used when Lesson.passingScore is null

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage

# --- Contact & feedback ---
# Shown on the subjects page as a mailto: link for teachers who want to build a course.
# Leave empty to hide the callout.
CONTACT_EMAIL=
SUGGESTIONS_MAX_PER_DAY=5           # improvement suggestions one user may submit per 24 hours

# --- Seed ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_EMAIL=
